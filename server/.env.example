NODE_ENV=production
PORT=3000

# PostgreSQL (Render PostgreSQL, Neon ou outro PostgreSQL com TLS)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require
PG_SSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=10

# Use no mínimo 32 caracteres aleatórios
JWT_SECRET=COLOQUE_UM_SEGREDO_ALEATORIO_COM_32_CARACTERES_OU_MAIS
JWT_ISSUER=brincar-de-desejo-api
JWT_AUDIENCE=brincar-de-desejo-web
JWT_EXPIRES_IN=2h

# Separe várias origens por vírgula, sem barra final
ALLOWED_ORIGINS=https://SEU-USUARIO.github.io

# Administrador inicial — senha com no mínimo 10 caracteres, letras e números
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=TROQUE_ESTA_SENHA_123
ADMIN_NAME=Administrador

# Limites opcionais
MAX_JSON_SIZE=3mb
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=10
ORDER_RATE_LIMIT_MAX=20
REVIEW_RATE_LIMIT_MAX=10
